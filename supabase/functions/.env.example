# Secrets das Edge Functions — configure com:
#   supabase secrets set --env-file supabase/functions/.env
# NUNCA coloque estas chaves no aplicativo.

# Transcrição (obrigatória para o registro por voz). Opção GRATUITA:
# crie uma chave em https://console.groq.com/keys
GROQ_API_KEY=
# Alternativa paga: OPENAI_API_KEY=

# Opcional (pago): interpretação e análises com Claude. Sem esta chave o app
# usa o interpretador por regras em português, que é gratuito.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Opcional: origem permitida no CORS (ex.: https://SEU_USUARIO.github.io)
ALLOWED_ORIGIN=*
