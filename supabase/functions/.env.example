# Secrets das Edge Functions — configure com:
#   supabase secrets set --env-file supabase/functions/.env
# NUNCA coloque estas chaves no aplicativo.
ANTHROPIC_API_KEY=
# Opcional: modelo usado na extração e nas análises (padrão: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
# Opcional: modelo de transcrição (padrão: gpt-4o-transcribe)
STT_MODEL=gpt-4o-transcribe
# Opcional: origem permitida no CORS (ex.: https://app.meufinanceiro.com.br)
ALLOWED_ORIGIN=*
